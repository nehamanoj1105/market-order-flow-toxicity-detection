# ---------------------------------------------------------------------------
# ingestor configuration (all values are optional; these are the defaults)
# Copy to .env and adjust, or export directly:
#   cp .env.example .env && ./ingestor -env-file .env
# Environment variables always win over the file.
# ---------------------------------------------------------------------------

## Service ------------------------------------------------------------------
SERVICE_NAME=ingestor
ENVIRONMENT=dev
LOG_LEVEL=info            # debug | info | warn | error
LOG_FORMAT=json           # json | text
LOG_OUTPUT=auto           # auto | stdout | stderr  (auto keeps `| jq` clean)
HTTP_ADDR=:9090           # /metrics /healthz /readyz /
STATS_EVERY=15s           # throughput heartbeat in the logs

## Data feed ----------------------------------------------------------------
FEED_MODE=csv             # live | csv | synthetic
FEED_SYMBOLS=BTCUSDT      # comma separated, also the CSV fallback symbol
EXCHANGE=binance
FEED_QUEUE_SIZE=8192

## CSV replay (FEED_MODE=csv) -----------------------------------------------
CSV_PATH=../data/sample_binance_trades.csv
CSV_FORMAT=auto           # auto | binance-trades | binance-aggtrades
CSV_HAS_HEADER=auto       # auto | true | false
CSV_SPEED=50              # 1 = realtime, 0 = as fast as possible
CSV_LOOP=false
CSV_MAX_ROWS=0            # 0 = no limit
CSV_START_ROW=0

## Synthetic feed (FEED_MODE=synthetic) -------------------------------------
SYNTH_SEED=42
SYNTH_TRADES_PER_SEC=50
SYNTH_START_PRICE=65000
SYNTH_VOLATILITY=0.35
SYNTH_TICK_SIZE=0.01
SYNTH_BASE_QTY=0.05
SYNTH_BURST_EVERY=90s     # start a toxic burst this often
SYNTH_BURST_DURATION=12s
SYNTH_BURST_IMBALANCE=0.88   # share of prints on the toxic side
SYNTH_BURST_RATE_FACTOR=4
SYNTH_BURST_SIZE_FACTOR=3
SYNTH_MAX_DURATION=0      # 0 = run forever

## Live Binance websocket (FEED_MODE=live) ----------------------------------
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com
BINANCE_STREAM=aggTrade    # aggTrade | trade
BINANCE_BACKFILL=false      # REST fill of the gap left by a restart
BINANCE_BACKFILL_LIMIT=1000
BINANCE_PING_INTERVAL=20s
BINANCE_READ_TIMEOUT=60s
BINANCE_RECONNECT_MIN=500ms
BINANCE_RECONNECT_MAX=30s
BINANCE_MAX_RECONNECTS=0    # 0 = unlimited

## Pipeline -----------------------------------------------------------------
PIPELINE_WORKERS=4
PIPELINE_CHANNEL_SIZE=1024
PIPELINE_SHUTDOWN_GRACE=20s
DEDUP_ENABLED=true
DEDUP_TTL=10m
DEDUP_MAX_KEYS=1000000

## Broker -------------------------------------------------------------------
BROKER=stdout             # kafka | rabbitmq | stdout | discard
PRODUCER_BATCH_SIZE=500
PRODUCER_LINGER=20ms
PRODUCER_QUEUE_SIZE=16384
PRODUCER_MAX_RETRIES=5
PRODUCER_RETRY_BASE=100ms
PRODUCER_RETRY_MAX=5s

## Kafka (BROKER=kafka) -----------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=trades.normalized
KAFKA_DLQ_TOPIC=trades.normalized.dlq
KAFKA_CLIENT_ID=tofd-ingestor
KAFKA_COMPRESSION=snappy  # none | gzip | snappy | lz4 | zstd
KAFKA_REQUIRED_ACKS=all   # none | one | all
KAFKA_WRITE_TIMEOUT=15s
KAFKA_BATCH_BYTES=1048576
KAFKA_AUTO_CREATE_TOPIC=true
KAFKA_TLS_ENABLED=false
KAFKA_TLS_SKIP_VERIFY=false
# KAFKA_SASL_MECHANISM=scram-sha-256   # "" | plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USER=
# KAFKA_SASL_PASSWORD=

## RabbitMQ (BROKER=rabbitmq) ----------------------------------------------
RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_EXCHANGE=trades
RABBIT_EXCHANGE_TYPE=topic
RABBIT_DLX=trades.dlx
RABBIT_ROUTING_KEY=trade.%s.%s
RABBIT_QUEUE=                # optional convenience queue for local dev
RABBIT_DURABLE=true
RABBIT_PERSISTENT=true
RABBIT_CONFIRMS=true
RABBIT_CONFIRM_TIMEOUT=10s

## Normalization ------------------------------------------------------------
SCHEMA_VERSION=1.0.0
NORMALIZE_COMPUTE_QUOTE_QTY=true
NORMALIZE_MAX_PRICE=0        # 0 disables
NORMALIZE_MAX_QUANTITY=0
NORMALIZE_MAX_AGE=0          # e.g. 5m to drop very stale trades
